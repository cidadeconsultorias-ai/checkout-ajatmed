PORT=3000

# Supabase — crie um projeto em https://supabase.com e preencha
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key

# Asaas — use sandbox para testes: https://sandbox.asaas.com (base https://api-sandbox.asaas.com/v3)
ASAAS_API_KEY=sua-api-key-do-asaas
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Link de checkout fixo (opcional, usado como fallback se a API não estiver configurada)
ASAAS_CHECKOUT_URL=
# Valor do plano (ex: 59.77) — exibido no resumo do pedido
PLAN_VALUE=59.77
# Nome do plano exibido no resumo
PLAN_NAME=Plano Individual AjatMed
# WhatsApp do concierge (card "Dúvidas na contratação?")
WHATSAPP_SUPPORT_URL=https://wa.me/5511999999999?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20o%20Plano%20AjatMed
